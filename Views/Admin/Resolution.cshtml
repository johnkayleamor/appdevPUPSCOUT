@{
    ViewData["Title"] = "Resolution and Workload";
    var from = (DateTime)ViewBag.From;
    var to = (DateTime)ViewBag.To;
}

<h1>Resolution time and staff workload</h1>

<form method="get" asp-action="Resolution" class="mb-3 d-flex gap-2 flex-wrap">
    <label class="form-label mb-0 align-self-center">From</label>
    <input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control" style="max-width:180px;" />
    <label class="form-label mb-0 align-self-center">To</label>
    <input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control" style="max-width:180px;" />
    <button class="btn btn-primary">Apply</button>
</form>

<h2>Resolution time</h2>
<p>Time to completion (Created to when staff marked work done) is the main measure. Auto-closed tickets include verification wait time in time to closed.</p>
<table class="table table-sm">
    <thead>
        <tr><th>Measure</th><th>Average hours</th><th>Tickets</th></tr>
    </thead>
    <tbody>
        <tr>
            <td>Time to completion</td>
            <td>@(ViewBag.CompletionAvg is null ? "N/A" : ((double)ViewBag.CompletionAvg).ToString("F1"))</td>
            <td>@ViewBag.CompletionCount</td>
        </tr>
        <tr>
            <td>Time to closed</td>
            <td>@(ViewBag.ClosedAvg is null ? "N/A" : ((double)ViewBag.ClosedAvg).ToString("F1"))</td>
            <td>@ViewBag.ClosedCount</td>
        </tr>
    </tbody>
</table>

<h3>By category</h3>
<table class="table table-sm">
    <thead>
        <tr><th>Category</th><th>Total</th><th>Completed</th><th>Avg completion hours</th><th>Closed</th><th>Avg closed hours</th></tr>
    </thead>
    <tbody>
        @foreach (var row in (IEnumerable<dynamic>)ViewBag.CategoryRows)
        {
            <tr>
                <td>@row.Category</td>
                <td>@row.Total</td>
                <td>@row.CompletionCount</td>
                <td>@(row.CompletionAvg is null ? "N/A" : ((double)row.CompletionAvg).ToString("F1"))</td>
                <td>@row.ClosedCount</td>
                <td>@(row.ClosedAvg is null ? "N/A" : ((double)row.ClosedAvg).ToString("F1"))</td>
            </tr>
        }
    </tbody>
</table>

<canvas id="categoryChart" height="120"></canvas>

<h2>Staff workload</h2>
<table class="table table-sm">
    <thead>
        <tr><th>Staff</th><th>Role</th><th>Open tickets</th><th>Closed tickets</th></tr>
    </thead>
    <tbody>
        @foreach (var row in (IEnumerable<dynamic>)ViewBag.WorkloadRows)
        {
            <tr>
                <td>@row.Email</td>
                <td>@row.Role</td>
                <td>@row.Open</td>
                <td>@row.Closed</td>
            </tr>
        }
    </tbody>
</table>

<h2>Report source</h2>
<table class="table table-sm">
    <thead>
        <tr><th>Source</th><th>Count</th><th>Percent</th></tr>
    </thead>
    <tbody>
        @for (int i = 0; i < ((List<string>)ViewBag.SourceLabels).Count; i++)
        {
            <tr>
                <td>@(((List<string>)ViewBag.SourceLabels)[i])</td>
                <td>@(((List<int>)ViewBag.SourceCounts)[i])</td>
                <td>@(((List<double>)ViewBag.SourcePercents)[i]).ToString("F1")%</td>
            </tr>
        }
    </tbody>
</table>
<p>Total: @ViewBag.TotalSource</p>

<canvas id="sourceChart" height="120"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const categoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CategoryLabels));
    const categoryAvgs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CategoryCompletionAvgs));
    const categoryCtx = document.getElementById('categoryChart');
    if (categoryCtx) {
        new Chart(categoryCtx, {
            type: 'bar',
            data: { labels: categoryLabels, datasets: [{ label: 'Avg completion hours', data: categoryAvgs }] },
            options: { responsive: true }
        });
    }

    const sourceLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SourceLabels));
    const sourceCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SourceCounts));
    const sourceCtx = document.getElementById('sourceChart');
    if (sourceCtx) {
        new Chart(sourceCtx, {
            type: 'pie',
            data: { labels: sourceLabels, datasets: [{ data: sourceCounts }] },
            options: { responsive: true }
        });
    }
</script>
