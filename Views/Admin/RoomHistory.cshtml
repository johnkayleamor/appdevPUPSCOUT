@model appdevPUPSCOUT.Models.Room

@{
    ViewData["Title"] = "Room History";
    var tickets = (List<appdevPUPSCOUT.Models.Ticket>)ViewBag.Tickets;
    var canSeeNames = User.IsInRole("Admin") || tickets.Any(t => t.AssigneeId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value);
}

<h1>Room History: @Model.Floor?.Building?.Name - @Model.Floor?.Name - @Model.Name</h1>

@if (!tickets.Any())
{
    <p>No reports for this room.</p>
}
else
{
    @foreach (var group in tickets.GroupBy(t => t.Equipment?.Name ?? "Unknown equipment").OrderBy(g => g.Key))
    {
        <h3 class="mt-3">@group.Key</h3>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Tracking</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Reporter</th>
                    <th>Assignee</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in group.OrderByDescending(x => x.CreatedAt))
                {
                    <tr>
                        <td><a asp-controller="Tickets" asp-action="Details" asp-route-id="@t.Id">@t.TrackingNumber</a></td>
                        <td>@t.Status</td>
                        <td>@t.Priority</td>
                        <td>@(canSeeNames ? (t.Reporter?.Email ?? t.ReporterId) : "Hidden")</td>
                        <td>@(canSeeNames ? (t.Assignee?.Email ?? "Unassigned") : "Hidden")</td>
                        <td>@t.CreatedAt.ToString("u")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<p class="mt-3"><a class="btn btn-secondary" asp-action="MostReported">Back</a></p>
