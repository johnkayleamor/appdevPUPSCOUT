@model appdevPUPSCOUT.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>

<form method="get" asp-action="Dashboard" class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label">Start date</label>
        <input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">End date</label>
        <input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary" type="submit">Apply</button>
    </div>
</form>

<div class="mb-3">
    <strong>Total unresolved:</strong> @Model.TotalCount
    @foreach (var kv in Model.Counts.OrderBy(k => k.Key))
    {
        <span class="badge bg-secondary ms-2">@kv.Key: @kv.Value</span>
    }
</div>

<table class="table table-sm">
    <thead>
        <tr>
            <th>Tracking</th>
            <th>Room / Equipment</th>
            <th>Category</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Reporter</th>
            <th>Assignee</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Tickets)
        {
            <tr>
                <td><a asp-controller="Tickets" asp-action="Details" asp-route-id="@t.Id">@t.TrackingNumber</a></td>
                <td>@t.Room?.Floor?.Building?.Name - @t.Room?.Floor?.Name - @t.Room?.Name<br /><small>@t.Equipment?.Name</small></td>
                <td>@t.Category</td>
                <td>@t.Priority</td>
                <td>@t.Status</td>
                <td>@t.Reporter?.Email</td>
                <td>@(t.Assignee?.Email ?? "Unassigned")</td>
                <td>@t.CreatedAt.ToString("u")</td>
            </tr>
        }
    </tbody>
</table>
