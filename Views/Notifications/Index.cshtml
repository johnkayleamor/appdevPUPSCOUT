@model List<appdevPUPSCOUT.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    int page = ViewBag.Page is int p ? p : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
}

<h1>Notifications</h1>

<form asp-action="MarkAllRead" method="post" class="mb-3">
    <button class="btn btn-secondary" type="submit">Mark all read</button>
</form>

@if (!Model.Any())
{
    <p>No notifications.</p>
}
else
{
    <ul class="list-group">
        @foreach (var n in Model)
        {
            <li class="list-group-item @(n.IsRead ? "" : "list-group-item-warning")">
                <div class="d-flex justify-content-between">
                    <div>
                        @if (!string.IsNullOrWhiteSpace(n.Link))
                        {
                            <a href="@n.Link">@n.Message</a>
                        }
                        else
                        {
                            @n.Message
                        }
                    </div>
                    <small class="text-muted">@n.CreatedAt.ToString("u")</small>
                </div>
                @if (!n.IsRead)
                {
                    <form asp-action="MarkRead" method="post" class="mt-2">
                        <input type="hidden" name="id" value="@n.Id" />
                        <button class="btn btn-sm btn-outline-primary" type="submit">Mark read</button>
                    </form>
                }
            </li>
        }
    </ul>

    @if (totalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
