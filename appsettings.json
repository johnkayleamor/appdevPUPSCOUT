{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=app.db;Cache=Shared"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Verification": {
    "TimeLimitHours": 72
  },
  "Email": {
    "Mode": "Simulated",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "SenderName": "PUPSCOUT",
    "SenderAddress": "",
    "Username": ""
  },
  "Support": {
    "AppealContact": "admin@pup.edu.ph"
  },
  "Priority": {
    "OpenReportThreshold": 3
  },
  "Otp": {
    "MaxAttempts": 5,
    "MinRequestSeconds": 60,
    "DailyEmailCap": 10,
    "DailyIpCap": 200,
    "BurstIpLimit": 10,
    "BurstWindowMinutes": 10,
    "ExpiryMinutes": 10,
    "CleanupAgeDays": 2
  },
  "Registration": {
    "AllowedEmailDomains": [ "pup.edu.ph", "iskolarngbayan.pup.edu.ph" ]
  }
}
